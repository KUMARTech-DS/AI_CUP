# Copy to .env for local API (never commit secrets)
ENVIRONMENT=local
PORT=8080
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
API_PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

DATA_DIR=./data_offline
DERIVED_DIR=./data_derived
DEMO_AUTH_ENABLED=true
JWT_SECRET=replace-me

# Identity Platform (Firebase Auth) — prod
IDENTITY_PLATFORM_ENABLED=false
IDENTITY_PLATFORM_PROJECT=
IDENTITY_WEB_API_KEY=
IDENTITY_TENANT_MAP_JSON={}
# Optional browser override:
# NEXT_PUBLIC_IDENTITY_API_KEY=

# GCP (deploy/deploy_cloud_run.sh sets all of these on Cloud Run).
# Each one left blank falls back to local files — /health → storage.local_fallbacks lists them.
GOOGLE_CLOUD_PROJECT=
GCP_REGION=asia-south1
GCS_BUCKET=
# Source JSON snapshots (orders, customers, stores, …) at gs://$GCS_RAW_BUCKET/$GCS_DATA_PREFIX
GCS_RAW_BUCKET=
GCS_DATA_PREFIX=data_offline/
GCS_IMAGE_BUCKET=
# Operational records (garments, campaigns, customers, privacy log); Secret Manager on Cloud Run
DATABASE_URL=
CLOUD_SQL_INSTANCE=
BQ_PROJECT=
BQ_MARTS_DATASET=suffai_marts
USE_BIGQUERY_MARTS=false
MONGO_URI=
ENABLE_VERTEX=false
VERTEX_LOCATION=asia-south1
VERTEX_MODEL=gemini-2.0-flash
# SKU ranking / Ads Lab (POST /api/v1/sku/rank). Images are ephemeral (memory → Vertex inline);
# without ENABLE_VERTEX a local colour/file-name heuristic stands in for extraction.
SKU_RANK_CONSENT_MODE=opt_out
SKU_RANK_MAX_IMAGE_BYTES=8388608
SKU_RANK_MAX_TOTAL_BYTES=31457280
SKU_RANK_VERTEX_CONCURRENCY=6
ENABLE_ADV=true
PRIVACY_DIFFERENCING_ENABLED=true
PRIVACY_K=30
EXPORT_REQUIRE_ROLE=brand_analyst
MEDIA_ACTIVATION_WEBHOOK=
PUBSUB_IMAGE_TOPIC=garment-image-uploaded
