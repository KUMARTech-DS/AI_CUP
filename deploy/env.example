# Copy to .env for local API (never commit secrets)
ENVIRONMENT=local
PORT=8080
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
API_PUBLIC_URL=http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

DATA_DIR=./data_offline
DERIVED_DIR=./data_derived
DEMO_AUTH_ENABLED=true
JWT_SECRET=replace-me

# Identity Platform (Firebase Auth) — prod
IDENTITY_PLATFORM_ENABLED=false
IDENTITY_PLATFORM_PROJECT=
IDENTITY_WEB_API_KEY=
IDENTITY_TENANT_MAP_JSON={}
# Optional browser override:
# NEXT_PUBLIC_IDENTITY_API_KEY=

# Set after GCP project approval
GOOGLE_CLOUD_PROJECT=
GCP_REGION=asia-south1
GCS_BUCKET=
GCS_RAW_BUCKET=
GCS_IMAGE_BUCKET=
DATABASE_URL=
CLOUD_SQL_INSTANCE=
BQ_PROJECT=
BQ_MARTS_DATASET=suffai_marts
USE_BIGQUERY_MARTS=false
MONGO_URI=
ENABLE_VERTEX=false
ENABLE_ADV=true
PRIVACY_DIFFERENCING_ENABLED=true
PRIVACY_K=30
EXPORT_REQUIRE_ROLE=brand_analyst
MEDIA_ACTIVATION_WEBHOOK=
PUBSUB_IMAGE_TOPIC=garment-image-uploaded
PUBSUB_EXTRACTION_SUBSCRIPTION=garment-image-uploaded-push
PUBSUB_SIMILARITY_SUBSCRIPTION=garment-image-uploaded-similarity-push

# Similarity / Command Center integration
# EXTRACTION_URL=https://suffai-extraction-….run.app
# SIMILARITY_URL=https://suffai-similarity-….run.app
USE_BQ=true
BQ_DATASET=suffai_ops
VERTEX_LOCATION=asia-south1
VERTEX_EMBED_MODEL=multimodalembedding@001
SIMILARITY_THRESHOLD=0.92
